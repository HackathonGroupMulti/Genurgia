# Backend URL used by the Next.js server.
BIOMECHANICS_API_URL=http://127.0.0.1:8000

# Comma-separated browser origins accepted by FastAPI for future client-side calls.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local artifact storage and the downloaded MediaPipe model.
KNEE_TWIN_ARTIFACT_DIR=./data/local
POSE_LANDMARKER_MODEL_PATH=./data/models/pose_landmarker_full.task

# Maximum accepted upload size in bytes (default: 100 MiB).
MAX_VIDEO_UPLOAD_BYTES=104857600
