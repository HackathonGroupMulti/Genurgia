  "required": [
    "study_instance_uid",
    "series_instance_uid",
    "frame_of_reference_uid",
    "sop_instance_uids",
    "instance_count",
    "rows",
    "columns",
    "pixel_spacing_mm",
    "image_orientation_patient",
    "first_image_position_patient_mm",
    "last_image_position_patient_mm",
    "dicom_laterality",
    "deidentification",
    "quality_signals",
    "status"
  ],
  "title": "DicomSeriesManifestV1",
  "type": "object"
}
