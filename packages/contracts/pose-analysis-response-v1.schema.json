{
  "$defs": {
    "CoordinateConvention": {
      "properties": {
        "image": {
          "const": "mediapipe-normalized-image-v1",
          "default": "mediapipe-normalized-image-v1",
          "title": "Image",
          "type": "string"
        },
        "image_axes": {
          "default": "origin top-left; +x right; +y down; x/y normalized by image size",
          "title": "Image Axes",
          "type": "string"
        },
        "image_depth": {
          "default": "MediaPipe model-relative z; smaller values are closer to camera",
          "title": "Image Depth",
          "type": "string"
        },
        "world": {
          "const": "mediapipe-pose-world-v1",
          "default": "mediapipe-pose-world-v1",
          "title": "World",
          "type": "string"
        },
        "world_units": {
          "const": "meter",
          "default": "meter",
          "title": "World Units",
          "type": "string"
        },
        "world_origin": {
          "default": "MediaPipe model-defined origin at the midpoint of the hips",
          "title": "World Origin",
          "type": "string"
        }
      },
      "title": "CoordinateConvention",
      "type": "object"
    },
    "PoseSequenceSummary": {
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "recording_id": {
          "format": "uuid",
          "title": "Recording Id",
          "type": "string"
        },
        "pose_model": {
          "title": "Pose Model",
          "type": "string"
        },
        "pose_model_version": {
          "title": "Pose Model Version",
          "type": "string"
        },
        "coordinate_convention": {
          "$ref": "#/$defs/CoordinateConvention"
        },
        "frame_count": {
          "exclusiveMinimum": 0,
          "title": "Frame Count",
          "type": "integer"
        },
        "detected_frame_count": {
          "minimum": 0,
          "title": "Detected Frame Count",
          "type": "integer"
        },
        "raw_landmarks_reference": {
          "title": "Raw Landmarks Reference",
          "type": "string"
        },
        "annotated_video_reference": {
          "title": "Annotated Video Reference",
          "type": "string"
        }
      },
      "required": [
        "id",
        "recording_id",
        "pose_model",
        "pose_model_version",
        "coordinate_convention",
        "frame_count",
        "detected_frame_count",
        "raw_landmarks_reference",
        "annotated_video_reference"
      ],
      "title": "PoseSequenceSummary",
      "type": "object"
    },
    "Recording": {
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "content_type": {
          "title": "Content Type",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
